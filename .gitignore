# Docs
site/
# Internal design / planning docs (NOT in the published mkdocs nav — end
# users don't need them; the rest of docs/ is the user-facing API/CLI/
# quickstart reference, which stays tracked).
docs/v1_design.md
docs/seq2seq_unification.md

# Distribution
*.tar.gz
*.whl

# Local correctness audit (not tracked; generated by audit/ scripts)
audit/

# audit2 — internal stress-test harness, probe outputs, and findings docs.
# End users don't need any of this; the committed test suite only imports the
# model registry (tests/test_resolver_golden.py: `from audit2 import _models`).
# ``audit2/*`` (not ``audit2/``) so the two needed files can be re-included.
audit2/*
!audit2/__init__.py
!audit2/_models.py

.other/


# Profiling / scratch
*.prof
*.lprof
